{
   "name": "fortenv",
   "version": "1.0.0",
   "description": "Remove ambient access to environment secrets with explicit function grants",
   "main": "./dist/index.js",
   "scripts": {
      "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await Promise.all(['dist', 'tsconfig.tsbuildinfo'].map((path) => rm(path, { recursive: true, force: true })));\"",
      "build": "pnpm run clean && tsc -p tsconfig.json",
      "typecheck": "tsc -p tsconfig.test.json --noFallthroughCasesInSwitch --allowUnreachableCode false --allowUnusedLabels false",
      "lint": "eslint .",
      "test": "pnpm run build && vitest run",
      "lint:fix": "eslint . --fix"
   },
   "keywords": [],
   "author": "",
   "license": "Apache-2.0",
   "type": "module",
   "types": "./dist/index.d.ts",
   "sideEffects": [
      "./dist/register.js"
   ],
   "files": [
      "dist",
      "LICENSE",
      "README.md",
      "docs/design.md"
   ],
   "engines": {
      "node": ">=22.23.2"
   },
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "default": "./dist/index.js"
      },
      "./config": {
         "types": "./dist/config.d.ts",
         "default": "./dist/config.js"
      },
      "./register": {
         "types": "./dist/register.d.ts",
         "default": "./dist/register.js"
      },
      "./telemetry": {
         "types": "./dist/telemetry.d.ts",
         "default": "./dist/telemetry.js"
      }
   },
   "devDependencies": {
      "@types/node": "^22.20.2",
      "typescript": "^7.0.2"
   }
}
