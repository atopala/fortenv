{
   "extends": "./tsconfig.json",
   "compilerOptions": {
      "noEmit": true,
      "composite": false,
      "allowJs": true,
      "checkJs": true,
      "allowImportingTsExtensions": true
   },
   "include": ["src/**/*.ts", "src/**/*.mts", "src/**/__tests__/**/*.js", "src/**/__tests__/**/*.mjs"],
   "exclude": [
