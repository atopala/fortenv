{
   "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "skipLibCheck": true,
      "allowJs": true,
      "checkJs": true,
      "noEmit": true,
      "types": ["node"]
   },
   "include": ["**/*.ts", "**/*.mjs"],
   "exclude": ["node_modules"]
}
